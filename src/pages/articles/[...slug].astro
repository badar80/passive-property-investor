---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const articles = await getCollection('articles');

	return articles.map((article) => ({
		params: { slug: article.id },
		props: { article },
	}));
}

const { article } = Astro.props;
const { Content } = await render(article);

const allArticles = await getCollection('articles');

const cities = [
  'coventry', 'birmingham', 'leicester', 'manchester',
  'leeds', 'sheffield', 'oxford', 'cambridge'
];

const articleCities = cities.filter(city =>
  article.id.toLowerCase().includes(city)
);

const isComparison = article.id.includes('-vs-');

const relatedArticles = allArticles
  .filter(other => other.id !== article.id)
  .map(other => {
    const otherCities = cities.filter(city =>
      other.id.toLowerCase().includes(city)
    );

    const sharedCities = articleCities.filter(city =>
      otherCities.includes(city)
    ).length;

    const otherIsComparison = other.id.includes('-vs-');
    const isUKResearch = other.id.startsWith('uk-');

    let score = sharedCities * 100;

    if (sharedCities > 0 && otherIsComparison) {
      score += 20;
    }

    if (isComparison === otherIsComparison) {
      score += 10;
    }

    if (isUKResearch) {
      score += 5;
    }

    return { ...other, score };
  })
  .sort((a, b) =>
    b.score - a.score ||
    a.data.title.localeCompare(b.data.title)
  )
  .slice(0, 6);
const canonicalURL = new URL(`/articles/${article.id}/`, Astro.site ?? 'https://passivepropertyinvestor.co.uk');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={article.data.description} />
		<link rel="canonical" href={canonicalURL} />
		<title>{article.data.title} | The Passive Property Investor</title>
	</head>

	<body>
		<main>
			<article>
				<a href="/">Ã¢â€ Â The Passive Property Investor</a>

				<h1>{article.data.title}</h1>

				<p>
					Published {article.data.pubDate.toLocaleDateString('en-GB', {
						day: 'numeric',
						month: 'long',
						year: 'numeric'
					})}
				</p>
	<div class="article-content">
    <Content />
</div>
			<section class="related-articles">
    <h2>Related Property Research</h2>
    <ul>
        {relatedArticles.map(related => (
            <li>
                <a href={`/articles/${related.id}/`}>
                    {related.data.title}
                </a>
            </li>
        ))}
    </ul>
</section>
</article>
		</main>
	</body>
</html>
<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
			"Segoe UI", sans-serif;
		color: #18202a;
		background: #ffffff;
	}

	:global(body) {
		margin: 0;
		line-height: 1.7;
	}

	main {
		width: min(860px, calc(100% - 40px));
		margin: 0 auto;
		padding: 55px 0 100px;
	}

	article > a {
		display: inline-block;
		margin-bottom: 45px;
		color: #0b6f5c;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.9rem;
	}

	h1 {
		font-size: clamp(2.6rem, 6vw, 4.5rem);
		line-height: 1.05;
		letter-spacing: -0.045em;
		color: #142532;
		margin: 0 0 24px;
	}

	article > p:first-of-type {
		color: #74818a;
		font-size: 0.9rem;
		margin-bottom: 50px;
	}

	.article-content :global(p) {
		font-size: 1.1rem;
		color: #3f4d57;
		margin: 0 0 24px;
	}

	article :global(h2) {
		font-size: 2rem;
		line-height: 1.2;
		color: #142532;
		margin: 55px 0 20px;
	}

	article :global(h3) {
		font-size: 1.4rem;
		color: #142532;
		margin: 40px 0 15px;
	}

	article :global(a) {
		color: #0b6f5c;
	}

	article :global(img) {
		width: 100%;
		max-width: 100%;
		height: auto;
		border-radius: 8px;
		margin: 25px 0;
	}

	@media (max-width: 600px) {
		main {
			padding-top: 35px;
		}

		h1 {
			font-size: 2.6rem;
		}
	}
.related-articles {
    margin-top: 70px;
    padding-top: 30px;
    border-top: 1px solid #dce5e2;
}
.related-articles li {
    margin-bottom: 12px;
}
.related-articles a {
    color: #0b6f5c;
    font-weight: 600;
}
        .article-content :global(table) {
                display: block;
                width: 100%;
                overflow-x: auto;
                border-collapse: collapse;
                margin: 28px 0 40px;
                font-size: 0.95rem;
        }

        .article-content :global(th),
        .article-content :global(td) {
                padding: 12px 16px;
                border-bottom: 1px solid #dce5e2;
                text-align: right;
                white-space: nowrap;
        }

        .article-content :global(th:first-child),
        .article-content :global(td:first-child) {
                text-align: left;
        }

        .article-content :global(th) {
                background: #0b7060;
                color: white;
                font-weight: 700;
        }

        .article-content :global(tbody tr:nth-child(even)) {
                background: #f2f7f5;
        }

        .article-content :global(tbody tr:hover) {
                background: #e5f2ed;
        }

</style>
