---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const articles = await getCollection('articles');

	return articles.map((article) => ({
		params: { slug: article.id },
		props: { article },
	}));
}

const { article } = Astro.props;
const { Content } = await render(article);

const canonicalURL = new URL(`/articles/${article.id}/`, Astro.site ?? 'https://passivepropertyinvestor.co.uk');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={article.data.description} />
		<link rel="canonical" href={canonicalURL} />
		<title>{article.data.title} | The Passive Property Investor</title>
	</head>

	<body>
		<main>
			<article>
				<a href="/">← The Passive Property Investor</a>

				<h1>{article.data.title}</h1>

				<p>
					Published {article.data.pubDate.toLocaleDateString('en-GB', {
						day: 'numeric',
						month: 'long',
						year: 'numeric'
					})}
				</p>

				<Content />
			</article>
		</main>
	</body>
</html>
<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
			"Segoe UI", sans-serif;
		color: #18202a;
		background: #ffffff;
	}

	:global(body) {
		margin: 0;
		line-height: 1.7;
	}

	main {
		width: min(860px, calc(100% - 40px));
		margin: 0 auto;
		padding: 55px 0 100px;
	}

	article > a {
		display: inline-block;
		margin-bottom: 45px;
		color: #0b6f5c;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.9rem;
	}

	h1 {
		font-size: clamp(2.6rem, 6vw, 4.5rem);
		line-height: 1.05;
		letter-spacing: -0.045em;
		color: #142532;
		margin: 0 0 24px;
	}

	article > p:first-of-type {
		color: #74818a;
		font-size: 0.9rem;
		margin-bottom: 50px;
	}

	article :global(p) {
		font-size: 1.1rem;
		color: #3f4d57;
		margin: 0 0 24px;
	}

	article :global(h2) {
		font-size: 2rem;
		line-height: 1.2;
		color: #142532;
		margin: 55px 0 20px;
	}

	article :global(h3) {
		font-size: 1.4rem;
		color: #142532;
		margin: 40px 0 15px;
	}

	article :global(a) {
		color: #0b6f5c;
	}

	article :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 8px;
		margin: 25px 0;
	}

	@media (max-width: 600px) {
		main {
			padding-top: 35px;
		}

		h1 {
			font-size: 2.6rem;
		}
	}
</style>
